{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedroluna-gh/preflightops/schemas/assessment-report-v1.schema.json",
  "title": "PreflightOps Assessment Report v1",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "audit",
    "decision",
    "scores",
    "controls",
    "evidence",
    "next_actions",
    "automation_details",
    "rendering",
    "data",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {
      "type": "string",
      "pattern": "^urn:preflightops:assessment-report:sha256:[0-9a-f]{64}$"
    },
    "audit": {
      "type": "object",
      "required": [
        "assessment_id",
        "assessment_schema_version",
        "assessment_timestamp",
        "change_id",
        "producer",
        "policy",
        "repository",
        "pull_request",
        "commit",
        "run",
        "pipeline",
        "input_hashes",
        "assessment_integrity",
        "canonical_assessment_sha256"
      ],
      "properties": {
        "assessment_id": {
          "type": "string",
          "pattern": "^urn:preflightops:assessment:sha256:[0-9a-f]{64}$"
        },
        "assessment_schema_version": {"const": "1.0"},
        "assessment_timestamp": {"$ref": "#/$defs/timestamp"},
        "change_id": {"$ref": "#/$defs/identifier"},
        "producer": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": {"const": "PreflightOps"},
            "version": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "required": ["name", "version", "hash"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 256},
            "version": {"type": "string", "minLength": 1, "maxLength": 128},
            "hash": {"$ref": "#/$defs/hash"}
          },
          "additionalProperties": false
        },
        "repository": {"type": "string", "minLength": 1, "maxLength": 1024},
        "pull_request": {"type": ["string", "null"], "maxLength": 128},
        "commit": {"type": "string", "minLength": 1, "maxLength": 1024},
        "run": {
          "type": "object",
          "required": ["id", "attempt"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "attempt": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "pipeline": {
          "type": "object",
          "required": ["name", "url"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 256},
            "url": {"oneOf": [{"$ref": "#/$defs/httpsUrl"}, {"type": "null"}]}
          },
          "additionalProperties": false
        },
        "input_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "hash"],
            "properties": {
              "name": {"$ref": "#/$defs/identifier"},
              "hash": {
                "type": "object",
                "required": ["algorithm", "value", "profile"],
                "properties": {
                  "algorithm": {"const": "sha256"},
                  "value": {"$ref": "#/$defs/sha256"},
                  "profile": {"const": "caller-supplied-sha256-v1"}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "assessment_integrity": {
          "type": "object",
          "required": ["algorithm", "value", "canonicalization"],
          "properties": {
            "algorithm": {"const": "sha256"},
            "value": {"$ref": "#/$defs/sha256"},
            "canonicalization": {"const": "preflightops-canonical-json-v1"}
          },
          "additionalProperties": false
        },
        "canonical_assessment_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["verdict", "technical_recommendation", "human_decision"],
      "properties": {
        "verdict": {
          "enum": ["BLOCK", "INDETERMINATE", "READY_FOR_HUMAN_REVIEW", "REVIEW_REQUIRED"]
        },
        "technical_recommendation": {
          "type": "object",
          "required": ["action", "summary", "basis", "grants_approval"],
          "properties": {
            "action": {
              "enum": ["BLOCK", "DO_NOT_PROCEED", "PROCEED", "PROCEED_WITH_CAUTION", "REVIEW"]
            },
            "summary": {"type": "string", "minLength": 1, "maxLength": 1024},
            "basis": {"const": "technical_only"},
            "grants_approval": {"const": false}
          },
          "additionalProperties": false
        },
        "human_decision": {"$ref": "#/$defs/humanDecision"}
      },
      "additionalProperties": false
    },
    "scores": {
      "type": "object",
      "required": ["risk", "confidence"],
      "properties": {
        "risk": {
          "type": "object",
          "required": ["value", "level"],
          "properties": {
            "value": {"type": "integer", "minimum": 0, "maximum": 100},
            "level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}
          },
          "additionalProperties": false
        },
        "confidence": {
          "type": "object",
          "required": ["value", "level", "basis"],
          "properties": {
            "value": {"type": "integer", "minimum": 0, "maximum": 100},
            "level": {"enum": ["LOW", "MEDIUM", "HIGH"]},
            "basis": {"const": "fresh-digest-pinned-control-observations-v1"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "required": ["counts", "top_blockers", "passed", "failed", "unknown", "errors", "warnings"],
      "properties": {
        "counts": {
          "type": "object",
          "required": ["PASS", "FAIL", "UNKNOWN", "ERROR"],
          "properties": {
            "PASS": {"type": "integer", "minimum": 0},
            "FAIL": {"type": "integer", "minimum": 0},
            "UNKNOWN": {"type": "integer", "minimum": 0},
            "ERROR": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "top_blockers": {"$ref": "#/$defs/boundedIssues"},
        "passed": {"$ref": "#/$defs/controls"},
        "failed": {"$ref": "#/$defs/controls"},
        "unknown": {"$ref": "#/$defs/controls"},
        "errors": {"$ref": "#/$defs/controls"},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["freshness_counts", "provenance"],
      "properties": {
        "freshness_counts": {
          "type": "object",
          "required": ["FRESH", "STALE", "UNKNOWN"],
          "properties": {
            "FRESH": {"type": "integer", "minimum": 0},
            "STALE": {"type": "integer", "minimum": 0},
            "UNKNOWN": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "evidence_id",
              "control_id",
              "kind",
              "source",
              "collected_at",
              "valid_until",
              "freshness",
              "hash",
              "links"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "pattern": "^urn:preflightops:evidence:sha256:[0-9a-f]{64}$"
              },
              "control_id": {"$ref": "#/$defs/identifier"},
              "kind": {"$ref": "#/$defs/identifier"},
              "source": {"type": "string", "minLength": 1, "maxLength": 1024},
              "collected_at": {"$ref": "#/$defs/timestamp"},
              "valid_until": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
              "freshness": {"enum": ["FRESH", "STALE", "UNKNOWN"]},
              "hash": {"$ref": "#/$defs/hash"},
              "links": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/httpsUrl"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "next_actions": {
      "type": "object",
      "required": ["total", "items", "omitted_count"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
        "omitted_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "automation_details": {
      "oneOf": [
        {
          "type": "object",
          "required": ["included"],
          "properties": {"included": {"const": false}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "included",
            "repository",
            "pull_request",
            "commit",
            "run_id",
            "run_attempt",
            "pipeline_name",
            "pipeline_url"
          ],
          "properties": {
            "included": {"const": true},
            "repository": {"type": "string", "minLength": 1, "maxLength": 1024},
            "pull_request": {"type": ["string", "null"], "maxLength": 128},
            "commit": {"type": "string", "minLength": 1, "maxLength": 1024},
            "run_id": {"$ref": "#/$defs/identifier"},
            "run_attempt": {"type": "integer", "minimum": 1},
            "pipeline_name": {"type": "string", "minLength": 1, "maxLength": 1024},
            "pipeline_url": {"oneOf": [{"$ref": "#/$defs/httpsUrl"}, {"type": "null"}]}
          },
          "additionalProperties": false
        }
      ]
    },
    "rendering": {
      "type": "object",
      "required": [
        "include_automation_details",
        "max_text_length",
        "top_blockers_limit",
        "next_actions_limit",
        "pr_summary_max_characters",
        "ticket_summary_max_characters",
        "redaction_profile"
      ],
      "properties": {
        "include_automation_details": {"type": "boolean"},
        "max_text_length": {"type": "integer", "minimum": 80, "maximum": 1024},
        "top_blockers_limit": {"type": "integer", "minimum": 1, "maximum": 20},
        "next_actions_limit": {"type": "integer", "minimum": 1, "maximum": 32},
        "pr_summary_max_characters": {"type": "integer", "minimum": 1000, "maximum": 65536},
        "ticket_summary_max_characters": {"type": "integer", "minimum": 1500, "maximum": 131072},
        "redaction_profile": {"const": "preflightops-report-redaction-v1"}
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": ["classification", "content_embedded", "redaction_profile"],
      "properties": {
        "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
        "content_embedded": {"const": false},
        "redaction_profile": {"const": "preflightops-report-redaction-v1"}
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "value", "canonicalization"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"$ref": "#/$defs/sha256"},
        "canonicalization": {"const": "preflightops-canonical-json-v1"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^?#]+$",
      "maxLength": 2048
    },
    "hash": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "humanDecision": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "decision", "actor_id", "decided_at", "rationale_code", "authority"],
          "properties": {
            "status": {"const": "NOT_RECORDED"},
            "decision": {"type": "null"},
            "actor_id": {"type": "null"},
            "decided_at": {"type": "null"},
            "rationale_code": {"type": "null"},
            "authority": {"const": "external_cab_or_change_management"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status", "decision", "actor_id", "decided_at", "rationale_code", "authority"],
          "properties": {
            "status": {"const": "RECORDED"},
            "decision": {"enum": ["APPROVE", "REJECT", "DEFER"]},
            "actor_id": {"$ref": "#/$defs/identifier"},
            "decided_at": {"$ref": "#/$defs/timestamp"},
            "rationale_code": {"$ref": "#/$defs/identifier"},
            "authority": {"const": "external_cab_or_change_management"}
          },
          "additionalProperties": false
        }
      ]
    },
    "issue": {
      "type": "object",
      "required": ["code", "control_id", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/identifier"},
        "control_id": {"$ref": "#/$defs/identifier"},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024}
      },
      "additionalProperties": false
    },
    "boundedIssues": {
      "type": "object",
      "required": ["total", "items", "omitted_count"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "items": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "omitted_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "required": [
        "control_id",
        "execution_id",
        "status",
        "risk_points",
        "summary",
        "source",
        "evidence_ids"
      ],
      "properties": {
        "control_id": {"$ref": "#/$defs/identifier"},
        "execution_id": {
          "type": "string",
          "pattern": "^urn:preflightops:control:sha256:[0-9a-f]{64}$"
        },
        "status": {"enum": ["PASS", "FAIL", "UNKNOWN", "ERROR"]},
        "risk_points": {"type": "integer", "minimum": 0},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1024},
        "source": {"type": "string", "minLength": 1, "maxLength": 1024},
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^urn:preflightops:evidence:sha256:[0-9a-f]{64}$"
          }
        }
      },
      "additionalProperties": false
    },
    "controls": {"type": "array", "items": {"$ref": "#/$defs/control"}},
    "action": {
      "type": "object",
      "required": ["code", "control_id", "action"],
      "properties": {
        "code": {"$ref": "#/$defs/identifier"},
        "control_id": {"$ref": "#/$defs/identifier"},
        "action": {"type": "string", "minLength": 1, "maxLength": 1024}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
