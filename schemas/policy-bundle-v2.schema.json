{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedroluna-gh/preflightops/schemas/policy-bundle-v2.schema.json",
  "title": "PreflightOps Policy Bundle v2",
  "type": "object",
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "preflightops.dev/policy/v2"},
    "kind": {"const": "PolicyBundle"},
    "metadata": {
      "type": "object",
      "required": ["name", "version", "owner", "effective_from", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "effective_from": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["draft", "active", "retired"]}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["failure_modes", "mandatory_controls", "base", "overlays"],
      "properties": {
        "failure_modes": {
          "type": "object",
          "required": ["policy_validation", "signature", "context_conflict", "evidence_unavailable"],
          "properties": {
            "policy_validation": {"const": "closed"},
            "signature": {"const": "closed"},
            "context_conflict": {"const": "closed"},
            "evidence_unavailable": {"enum": ["open", "closed"]}
          },
          "additionalProperties": false
        },
        "mandatory_controls": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "base": {"$ref": "#/$defs/policy"},
        "overlays": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "priority", "match", "apply"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "priority": {"type": "integer"},
              "match": {
                "type": "object",
                "minProperties": 1,
                "properties": {
                  "environment": {"$ref": "#/$defs/match"},
                  "tier": {"$ref": "#/$defs/match"},
                  "change_class": {"$ref": "#/$defs/match"},
                  "change_type": {"$ref": "#/$defs/match"}
                },
                "additionalProperties": false
              },
              "apply": {"$ref": "#/$defs/policy"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "match": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      ]
    },
    "weights": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 100}
    },
    "thresholds": {
      "type": "object",
      "required": ["low", "medium", "high"],
      "properties": {
        "low": {"type": "integer", "minimum": 0, "maximum": 97},
        "medium": {"type": "integer", "minimum": 1, "maximum": 98},
        "high": {"type": "integer", "minimum": 2, "maximum": 99}
      },
      "additionalProperties": false
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "minimum_enabled_monitors": {"type": "integer", "minimum": 0},
        "required_providers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "risk_weights": {"$ref": "#/$defs/weights"},
        "risk_level_thresholds": {"$ref": "#/$defs/thresholds"},
        "monitoring": {"$ref": "#/$defs/monitoring"}
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
