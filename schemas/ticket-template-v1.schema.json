{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedroluna-gh/preflightops/schemas/ticket-template-v1.schema.json",
  "title": "PreflightOps Ticket Template v1",
  "type": "object",
  "properties": {
    "title": {"type": "string"},
    "footer": {"type": "string"},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heading", "content"],
        "properties": {
          "heading": {"type": "string", "minLength": 1},
          "content": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "approvals": {"$ref": "#/$defs/levelMap"},
    "deployment_windows": {"$ref": "#/$defs/levelMap"}
  },
  "$defs": {
    "levelMap": {
      "type": "object",
      "properties": {
        "LOW": {"type": "string"},
        "MEDIUM": {"type": "string"},
        "HIGH": {"type": "string"},
        "CRITICAL": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
