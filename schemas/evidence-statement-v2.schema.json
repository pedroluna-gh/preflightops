{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedroluna-gh/preflightops/schemas/evidence-statement-v2.schema.json",
  "title": "PreflightOps Evidence Contract v2 in-toto Statement",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "digest": {
            "type": "object",
            "required": ["sha256"],
            "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "predicateType": {"const": "https://preflightops.dev/attestations/evidence/v2"},
    "predicate": {
      "type": "object",
      "required": [
        "schema_version",
        "generated_at",
        "producer",
        "organization",
        "context",
        "provenance",
        "policy",
        "inputs",
        "assessment",
        "assessment_digest",
        "data",
        "governance"
      ],
      "properties": {
        "schema_version": {"const": "2.0"},
        "generated_at": {"type": "string", "format": "date-time"},
        "producer": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": {"const": "PreflightOps"},
            "version": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "organization": {"type": "string"},
        "context": {
          "type": "object",
          "required": ["repository", "commit", "ref", "service", "environment", "change_id"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "commit": {"type": "string", "minLength": 1},
            "ref": {"type": "string"},
            "service": {"type": "string"},
            "environment": {"type": "string"},
            "change_id": {"type": "string"}
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "organization": {"type": "string"},
            "repository": {"type": "string"},
            "commit": {"type": "string"},
            "ref": {"type": "string"},
            "workflow": {"type": "string"},
            "run_id": {"type": "string"},
            "run_attempt": {"type": "string"},
            "actor": {"type": "string"},
            "run_url": {"type": "string", "format": "uri"}
          },
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "required": ["name", "version", "digest"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "digest": {
              "type": "object",
              "required": ["sha256"],
              "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "digest"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 256},
              "digest": {
                "type": "object",
                "required": ["sha256"],
                "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "assessment": {"type": "object"},
        "assessment_digest": {
          "type": "object",
          "required": ["sha256"],
          "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
          "additionalProperties": false
        },
        "data": {
          "type": "object",
          "required": ["classification", "redaction_profile", "content_embedded"],
          "properties": {
            "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
            "redaction_profile": {"const": "preflightops-default-v1"},
            "content_embedded": {"const": false}
          },
          "additionalProperties": false
        },
        "governance": {
          "type": "object",
          "required": ["purpose", "cab_authority", "changes_workflow_state", "grants_approval"],
          "properties": {
            "purpose": {"const": "Automated pre-change technical evidence"},
            "cab_authority": {"type": "string", "minLength": 1},
            "changes_workflow_state": {"const": false},
            "grants_approval": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
