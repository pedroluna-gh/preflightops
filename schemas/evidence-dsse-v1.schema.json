{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedroluna-gh/preflightops/schemas/evidence-dsse-v1.schema.json",
  "title": "PreflightOps DSSE envelope",
  "type": "object",
  "required": ["payloadType", "payload", "signatures"],
  "properties": {
    "payloadType": {"const": "application/vnd.in-toto+json"},
    "payload": {"type": "string", "contentEncoding": "base64", "minLength": 1},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["keyid", "sig"],
        "properties": {
          "keyid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "sig": {"type": "string", "contentEncoding": "base64", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
