{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pedroluna-gh/preflightops/schemas/semantic-validation-v1.schema.json",
  "title": "PreflightOps Semantic Validation v1",
  "type": "object",
  "required": [
    "schema_version", "semantic_validation_id", "evaluated_at", "policy", "controls",
    "summary", "compatibility", "data", "integrity"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "semantic_validation_id": {"type": "string", "pattern": "^urn:preflightops:semantic-validation:sha256:[0-9a-f]{64}$"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "policy": {
      "type": "object",
      "required": ["name", "version", "max_age_seconds", "confidence_basis"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "max_age_seconds": {"type": "integer", "minimum": 1},
        "confidence_basis": {"const": "determinability-freshness-provenance-v1"}
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/control"}
    },
    "summary": {
      "type": "object",
      "required": ["status", "confidence", "counts"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "confidence": {"$ref": "#/$defs/summaryConfidence"},
        "counts": {
          "type": "object",
          "required": ["PASS", "FAIL", "UNKNOWN", "ERROR", "NOT_APPLICABLE"],
          "properties": {
            "PASS": {"type": "integer", "minimum": 0},
            "FAIL": {"type": "integer", "minimum": 0},
            "UNKNOWN": {"type": "integer", "minimum": 0},
            "ERROR": {"type": "integer", "minimum": 0},
            "NOT_APPLICABLE": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": ["source_contract", "adapter_version", "legacy_validators_preserved", "legacy_output_preserved"],
      "properties": {
        "source_contract": {"type": "string", "minLength": 1},
        "adapter_version": {"const": "1.0"},
        "legacy_validators_preserved": {"const": true},
        "legacy_output_preserved": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": ["classification", "content_embedded", "metadata_profile"],
      "properties": {
        "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
        "content_embedded": {"const": false},
        "metadata_profile": {"const": "preflightops-semantic-metadata-v1"}
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "value", "canonicalization"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonicalization": {"const": "preflightops-canonical-json-v1"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "status": {"enum": ["PASS", "FAIL", "UNKNOWN", "ERROR", "NOT_APPLICABLE"]},
    "level": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "summaryConfidence": {
      "type": "object",
      "required": ["value", "level", "basis"],
      "properties": {
        "value": {"type": "integer", "minimum": 0, "maximum": 100},
        "level": {"$ref": "#/$defs/level"},
        "basis": {"const": "determinability-freshness-provenance-v1"}
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "required": ["value", "level", "basis", "cap", "components"],
      "properties": {
        "value": {"type": "integer", "minimum": 0, "maximum": 100},
        "level": {"$ref": "#/$defs/level"},
        "basis": {"const": "determinability-freshness-provenance-v1"},
        "cap": {"type": "integer", "minimum": 0, "maximum": 100},
        "components": {
          "type": "object",
          "required": ["determinability", "freshness", "provenance"],
          "properties": {
            "determinability": {"type": "integer", "minimum": 0, "maximum": 60},
            "freshness": {"type": "integer", "minimum": 0, "maximum": 25},
            "provenance": {"type": "integer", "minimum": 0, "maximum": 15}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "required": ["code", "field", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 256},
        "field": {"type": "string", "minLength": 1, "maxLength": 256},
        "message": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["source", "provider_status", "parser_status", "collected_at", "valid_until", "effective_valid_until", "hash"],
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 256},
        "provider_status": {"enum": ["AVAILABLE", "ABSENT", "ERROR"]},
        "parser_status": {"enum": ["OK", "ERROR"]},
        "collected_at": {"type": ["string", "null"], "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"},
        "effective_valid_until": {"type": ["string", "null"], "format": "date-time"},
        "hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}
      },
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "required": ["execution_id", "control_id", "status", "freshness", "confidence", "issues", "evidence"],
      "properties": {
        "execution_id": {"type": "string", "pattern": "^urn:preflightops:semantic-control:sha256:[0-9a-f]{64}$"},
        "control_id": {"enum": ["monitoring-plan", "rollback-plan", "validation-plan"]},
        "status": {"$ref": "#/$defs/status"},
        "freshness": {"enum": ["FRESH", "STALE", "UNKNOWN"]},
        "confidence": {"$ref": "#/$defs/confidence"},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "evidence": {"$ref": "#/$defs/evidence"}
      },
      "additionalProperties": false
    }
  }
}
